{
  "name": "waldemar",
  "version": "1.0.0",
  "description": "⚔️ Waldemar of Falkensee - Captain of the King's Personal Guard, Warden of the Ordered Line, and disciplined codewright agent for pi.",
  "author": "The Court",
  "maintainers": [],
  "keywords": [
    "pi-package",
    "waldemar",
    "developer-agent",
    "noble",
    "extension",
    "theme",
    "coding-agent",
    "fantasy-theme"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DZunke/pi-waldemar.git"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "./node_modules/pi-extensions/usage-extension/index.ts",
      "./node_modules/pi-subagents/index.js"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    },
    "themes": [
      "./themes"
    ],
    "image": "https://raw.githubusercontent.com/DZunke/pi-waldemar/main/waldemar-of-falkensee.png"
  },
  "dependencies": {
    "pi-extensions": "git+https://github.com/tmustier/pi-extensions.git#c42103a5734c11f75cb5b046c56b4784de0e1c54",
    "pi-subagents": "0.76.1"
  },
  "bundledDependencies": [
    "pi-extensions",
    "pi-subagents"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "bootstrap:skills": "./scripts/bootstrap-skills.sh",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mjs"
  },
  "homepage": "https://github.com/DZunke/pi-waldemar#readme",
  "bugs": {
    "url": "https://github.com/DZunke/pi-waldemar/issues"
  },
  "license": "MIT"
}
